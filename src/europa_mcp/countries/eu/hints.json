  "entries": [
    {
      "source": "European Parliament",
      "id": "ep_meps",
      "title": "Current Members of the European Parliament (MEPs) by country and political group",
      "keywords": "MEPs members politicians country group EPP S&D Renew Greens ECR",
      "call": "ep_meps(country=\"NL\")"
    },
    {
      "source": "European Parliament",
      "id": "ep_votes",
      "title": "Plenary votes by sitting day: outcome and for/against/abstain counts, per-MEP roll-call votes",
      "keywords": "votes voting roll-call results plenary decisions how did MEP vote",
      "call": "ep_votes(date=\"YYYY-MM-DD\")"
    },
    {
      "source": "data.europa.eu",
      "id": "dataeu_search",
      "title": "Search 1.9M open datasets from EU institutions and national/regional portals (files, APIs, maps)",
      "keywords": "open data catalogue datasets portal download csv files any topic national regional municipal",
      "call": "dataeu_search(query=\"...\")"
    },
    {
      "source": "data.europa.eu",
      "id": "dataeu_facets",
      "title": "Which portals, formats and themes hold open datasets on a topic (counts before searching)",
      "keywords": "overview breakdown counts catalogues portals formats categories themes publishers licences high value datasets hvd",
      "call": "dataeu_facets(query=\"...\", country=\"nl\")"
    },
    {
      "source": "data.europa.eu",
      "id": "dataeu_sparql",
      "title": "SPARQL over the DCAT metadata graph of all EU open datasets",
      "keywords": "sparql rdf linked data dcat metadata counts publishers formats",
      "call": "dataeu_sparql(query=\"SELECT ...\")"
    },
    {
      "source": "data.europa.eu",
      "id": "dataeu_quality",
      "title": "Metadata quality (MQA) scores of open data portals per country or catalogue",
      "keywords": "metadata quality score MQA FAIR open data maturity portals",
      "call": "dataeu_quality(scope=\"country\", id=\"NLD\")"
    },
    {
      "source": "data.europa.eu",
      "id": "dataeu_use_cases",
      "title": "Use cases: apps and projects built on EU open data",
      "keywords": "use cases applications apps projects reuse examples impact",
      "call": "dataeu_use_cases(query=\"...\")"
    }
  ],
